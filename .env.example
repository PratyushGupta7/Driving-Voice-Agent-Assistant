# Copy to `.env` in this directory. Never commit real values.

# --- LiveKit (local `livekit-server --dev`) ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=middrive
LIVEKIT_API_SECRET=abc75afd7b78117bf2466956612c189cc9b810dbd9d2178c5995b3bcc5203050
AGENT_NAME=mid-drive

# --- ElevenLabs STT ---
ELEVEN_API_KEY=

# --- Rime TTS (primary spoken output) ---
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=astra
RIME_LANGUAGE=eng
RIME_SAMPLE_RATE=24000
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# --- Azure OpenAI (mission / conversation LLM) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- Demo gate (optional). If set, the token endpoint requires it. ---
DEMO_ACCESS_TOKEN= 

# --- Geo (fixture is the judged default) ---
GEO_MODE=fixture
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTE_ORIGIN=Cyber Hub, Gurugram
ROUTE_DESTINATION=Connaught Place, New Delhi

# --- Persistence ---
DATABASE_URL=sqlite+aiosqlite:///./artifacts/mid_drive.db
